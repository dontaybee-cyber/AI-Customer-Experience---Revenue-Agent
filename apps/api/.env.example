# Server
PORT=3001

# OpenAI — required for production LLM responses
# Falls back to StubLlmClient if not set (useful for local dev)
OPENAI_API_KEY=sk-your-key-here

# Supabase — required for memory/continuity store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redis / Upstash — required for BullMQ trigger queue
# Use rediss:// (with double-s) for Upstash TLS connections
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379

# HubSpot — required for CRM sync and deal creation
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token-here

# Telegram — required for customer messaging and admin alerts
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id-here

# Security — used for audit log identifier hashing
# Any non-empty string works; change per environment
AUDIT_HASH_SALT=change-me-per-environment
