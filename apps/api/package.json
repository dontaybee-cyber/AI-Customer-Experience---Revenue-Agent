{
  "name": "acx-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/server.js",
    "dev:worker": "node --watch --enable-source-maps dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run lint && pnpm run format:check",
    "lint": "oxlint src",
    "format:check": "oxfmt --check src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "LIVE=1 vitest run"
  },
  "dependencies": {
    "@acx/connectors": "workspace:*",
    "@acx/memory": "workspace:*",
    "@acx/shared": "workspace:*",
    "@acx/trigger-engine": "workspace:*",
    "bullmq": "^5.70.1",
    "fastify": "^5.2.1",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
